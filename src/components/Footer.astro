---
import FutureLink from "./FutureLink.astro";
import { site } from "../data/site";
const sections = ["Що лікуємо", "Напрямки", "Консультації лікарів", "Усі фахівці", "Повний прайс", "Правила для пацієнтів", "Протипоказання"];
---
<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <a class="logo" href="#top" aria-label="Somatica — на початок сторінки">
        <picture>
          <source srcset="/img/somatica-logo.webp" type="image/webp" />
          <img src="/img/somatica-logo.png" alt="Somatica — Український центр реабілітації" width="145" height="37" />
        </picture>
      </a>
      <a class="site-footer__phone" href={site.phone.href}>{site.phone.text}</a>
      <p class="site-footer__text">
        <a class="text-link" href={site.email.href}>{site.email.text}</a><br />
        Київ, {site.address.street}, {site.address.floor}, {site.address.metro}<br />
        Пн–Сб {site.hours.time}, Нд вихідний
      </p>
      <a class="text-link text-link--icon" href={site.instagram.href} rel="noopener" target="_blank">
        <span>Instagram {site.instagram.handle}</span><span class="visually-hidden"> (відкриється в новій вкладці)</span>
      </a>
    </div>
    <nav class="site-footer__nav" aria-label="Розділи сайту">
      <p class="site-footer__label">Розділи сайту</p>
      <ul class="site-footer__list">
        {sections.map((s) => <li><FutureLink>{s}</FutureLink></li>)}
      </ul>
    </nav>
  </div>
  <div class="container site-footer__bottom">
    <p>© 2026 Somatica</p>
    <FutureLink>Політика конфіденційності</FutureLink>
  </div>
</footer>
