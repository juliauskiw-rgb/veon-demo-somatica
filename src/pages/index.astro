---
// Somatica homepage (DEMO). Structure, copy and order: design/concept.md §8, ux/demo-home.md §5.
// Facts only from veon/client.json; ids in comments.
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import CallButton from "../components/CallButton.astro";
import FutureLink from "../components/FutureLink.astro";
import CallBar from "../components/CallBar.astro";
import { site } from "../data/site";

const title = "Реабілітація і кінезітерапія в Києві — Somatica";
const description = "Реабілітація після операцій і травм, лікування болю в спині й суглобах, кінезітерапія для дітей і дорослих. Лобановського 17, м. Деміївська. Тел. 066 334 53 73";

// Situations: wording of the patient, states from the current site lists (audit/screens/home-mobile-s02…s05).
const situations = [
  {
    id: "problem-back",
    index: "Болить спина",
    title: "Болить спина",
    who: "лікар ФРМ, невролог, ортопед-травматолог",
    states: ["Біль у попереку, спині, грудному відділі", "Міжхребцеві грижі, остеохондроз", "Ішіас, корінцевий синдром", "Артроз, артрит, біль у коліні й кульшовому суглобі"],
    page: "Детально про лікування болю",
  },
  {
    id: "problem-surgery",
    index: "Після операції",
    title: "Після операції",
    who: "лікар ФРМ, програма кінезітерапії",
    states: ["Відновлення після операцій", "Відновлення після пластичних операцій", "Післяопераційний абонемент кінезітерапії — 12 занять"],
    page: "Детально про реабілітацію після операцій",
  },
  {
    id: "problem-sport",
    index: "Після травми",
    title: "Після травми",
    who: "спортивний лікар, ортопед-травматолог",
    states: ["Відновлення після спортивних травм", "Забої", "Слабкість зв'язкового апарату", "Кінезіологічне тейпування"],
    page: "Детально про спортивну реабілітацію",
  },
  {
    id: "problem-military",
    index: "Для військових",
    title: "Для військових",
    who: "реабілітація військових і учасників бойових дій, умови — за телефоном",
    states: ["Реабілітація військовослужбовців і учасників бойових дій", "Умови й порядок запису уточнюйте за телефоном"],
    page: "Детально про реабілітацію військових",
  },
  {
    id: "problem-muscles",
    index: "М'язи і втома",
    title: "М'язи і втома",
    who: "лікар ФРМ, фізичний терапевт",
    states: ["Гіпертонус, міозити", "М'язова слабкість (гіпотонус)", "Синдром хронічної втоми", "Групові та індивідуальні заняття, лікувальна фізкультура"],
    page: "Детально про оздоровлення",
  },
];

const directions = [
  { name: "Кінезітерапія", line: "Лікування рухом за індивідуальною програмою — для дітей і дорослих" },
  { name: "Лікувальна фізкультура", line: "Групові та індивідуальні заняття" },
  { name: "Лікувальний масаж", line: "Зокрема масаж з елементами кінезітерапії" },
  { name: "Кінезіологічне тейпування", line: "Лікувальне тейпування: вартість залежить від довжини стрічки" },
  { name: "Голкорефлексотерапія", line: "Вертеброневрологія, акупунктура" },
  { name: "Консультації лікарів", line: "Лікар ФРМ, невролог, ортопед-травматолог, спортивний лікар, рефлексотерапевт, психолог" },
];

// Only prices without conflicts between pages: C-008, C-009, C-010 (I-001), grouped under the patient situation.
const priceGroups = [
  { situation: "Після операції", id: "problem-surgery", items: [
    { name: "Післяопераційний абонемент кінезітерапії", note: "12 занять", price: "7200 грн" },
  ] },
  { situation: "Після травми", id: "problem-sport", items: [
    { name: "Кінезіотейпування", note: "від 0,5 до 2 м стрічки", price: "165–385 грн" },
  ] },
  { situation: "М'язи і втома", id: "problem-muscles", items: [
    { name: "Заняття ЛФК", price: "660 грн" },
    { name: "Індивідуальне заняття з фахівцем з фізичної реабілітації", price: "1100 грн" },
  ] },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MedicalClinic",
  name: "Somatica",
  description: "Центр медичної реабілітації і кінезітерапії в Києві",
  telephone: "+380663345373",
  email: "info@somatica.com.ua",
  address: {
    "@type": "PostalAddress",
    streetAddress: "просп. Валерія Лобановського, 17, 7 поверх",
    addressLocality: "Київ",
    addressCountry: "UA",
  },
  medicalSpecialty: ["PhysicalTherapy", "SportsMedicine"],
};
---
<Base lang="uk" title={title} description={description}>
  <script slot="head" type="application/ld+json" data-rec="R-202" set:html={JSON.stringify(jsonLd)} />
  <Header slot="header" />

  <!-- 1. Hero: static first screen, no slider (R-101, R-108) -->
  <Section id="hero" rec="R-101,R-108" class="hero">
    <div class="container hero__grid">
      <div class="hero__text">
        <h1 class="hero__title" data-rec="R-209">Центр медичної реабілітації і кінезітерапії Somatica в Києві</h1>
        <p class="hero__lead">Біль у спині й суглобах, відновлення після операцій і травм, реабілітація військових. Спершу — консультація лікаря.</p>
        <div class="hero__actions">
          <a class="hero__phone" href={site.phone.href}>{site.phone.text}</a>
          <CallButton size="lg" class="hero__call" rec="R-102" />
          <a class="text-link text-link--icon" href="#problems">
            <span>З чим звертаються</span>
            <Icon name="arrow-down" size={18} />
          </a>
        </div>
        <p class="hero__address">
          <Icon name="pin" size={18} />
          <span>Лобановського, 17, 7 поверх — поруч м. Деміївська</span>
        </p>
      </div>

      <div class="hero__index">
        <div class="hero__index-title" id="index-label">З чим до нас приходять</div>
        <ul class="index" aria-labelledby="index-label">
          {situations.map((s, i) => (
            <li class="index__item" style={`--i:${i}`}>
              <a class="index__link" href={`#${s.id}`} data-open={s.id}>
                <span class="index__phrase">{s.index}</span>
                <span class="index__who">{s.id === "problem-military" ? s.who : `Хто може прийняти: ${s.who}`}</span>
                <Icon name="arrow-right" size={24} class="index__arrow" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <!-- 2. Problems: five entries in the patient's words, open in place (R-104, R-103) -->
  <Section id="problems" rec="R-104,R-103" class="problems">
    <div class="container">
      <div class="problems__head">
        <h2 class="h2">З чим звертаються</h2>
        <p class="problems__intro">Оберіть свою ситуацію — побачите, з чим саме працюємо і хто вас прийме.</p>
      </div>
      <div class="problems__grid">
        {situations.map((s, i) => (
          <details class:list={["entry", { "entry--wide": i === 0 }]} id={s.id}>
            <summary class="entry__summary">
              <h3 class="entry__title">{s.title}</h3>
              <span class="entry__who">{s.id === "problem-military" ? s.who : `Хто може прийняти: ${s.who}`}</span>
              <span class="entry__toggle"><Icon name="chevron-down" size={22} /></span>
            </summary>
            <div class="entry__body">
              <ul class="entry__states">
                {s.states.map((st) => <li>{st}</li>)}
              </ul>
              <FutureLink class="future--on-band">{s.page}</FutureLink>
            </div>
          </details>
        ))}
      </div>
      <div class="band-call">
        <p class="band-call__text">Не знаєте, до якого лікаря? Подзвоніть — підкажемо, з чого почати.</p>
        <div class="band-call__row">
          <a class="band-call__phone" href={site.phone.href}>{site.phone.text}</a>
          <CallButton />
        </div>
      </div>
    </div>
  </Section>

  <!-- 3. Path: consultation → programme → course (R-105) -->
  <Section id="path" rec="R-105" class="path">
    <div class="container">
      <h2 class="h2">З чого почати</h2>
      <ol class="route" data-reveal>
        <li class="route__stop">
          <h3 class="route__title">Консультація лікаря</h3>
          <p>Лікар ФРМ, невролог, ортопед-травматолог або спортивний лікар оцінює стан і вирішує, які заняття вам підходять.</p>
        </li>
        <li class="route__stop">
          <h3 class="route__title">Індивідуальна програма</h3>
          <p>Кінезітерапія, ЛФК, масаж, тейпування — у поєднанні, яке підібрали саме для вас.</p>
        </li>
        <li class="route__stop">
          <h3 class="route__title">Курс занять</h3>
          <p>Разові заняття або абонемент. Наприклад, післяопераційний курс кінезітерапії — 12 занять.</p>
        </li>
      </ol>
      <div class="path__call">
        <CallButton label="Записатися на консультацію" />
        <FutureLink>Протипоказання</FutureLink>
      </div>
    </div>
  </Section>

  <!-- 4. Directions: typographic index of methods, each a future page -->
  <Section id="directions" class="directions">
    <div class="container directions__grid">
      <div class="directions__head">
        <h2 class="h2">Напрями реабілітації</h2>
        <p class="muted">Для тих, хто вже знає, який метод шукає.</p>
      </div>
      <ul class="dir-list">
        {directions.map((d, i) => (
          <li class="dir" style={`--i:${i}`}>
            <h3 class="dir__name"><FutureLink>{d.name}</FutureLink></h3>
            <p class="dir__line">{d.line}</p>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <!-- 5. Doctors: one real person + DOC.UA facts with source (C-011, C-015) -->
  <Section id="doctors" class="doctors">
    <div class="container doctors__grid">
      <div class="doctors__text">
        <h2 class="h2">Лікарі центру</h2>
        <div class="doctors__person">
          <figure class="placeholder placeholder--portrait" data-rec="R-305">
            <div class="placeholder__frame" role="img" aria-label="Місце для фото медичного директора Марини Марчук"></div>
            <figcaption class="placeholder__caption">фото — зображення клієнта</figcaption>
          </figure>
          <div>
            <p class="doctors__role">Медичний директор</p>
            <p class="doctors__name">Марчук Марина Миколаївна</p>
          </div>
        </div>
        <ul class="doctors__specs">
          <li>Лікар фізичної та реабілітаційної медицини (ФРМ)</li>
          <li>Лікар ультразвукової діагностики</li>
          <li>Спортивний лікар</li>
        </ul>
        <FutureLink class="doctors__all">Усі фахівці</FutureLink>
      </div>
      <aside class="doctors__aside" aria-label="Дані DOC.UA">
          <div class="doctors__facts">
          <p><strong class="doctors__fig">13 лікарів</strong> працюють у центрі, за даними DOC.UA.</p>
          <p><strong class="doctors__fig">5.0</strong> рейтинг центру на DOC.UA за 40 відгуками, листопад 2026.</p>
          <p class="doctors__source"><a class="text-link" href="https://doc.ua/klinika/kiev/somatika/somatka" rel="noopener" target="_blank">Профіль Somatica на DOC.UA<span class="visually-hidden"> (відкриється в новій вкладці)</span></a></p>
          </div>
      </aside>
    </div>
  </Section>

  <!-- 6. Prices: only prices without conflicts (R-107; C-008…C-010) -->
  <Section id="prices" rec="R-107" class="prices">
    <div class="container prices__grid">
      <div class="prices__head">
        <h2 class="h2">Орієнтовні ціни</h2>
        <p class="prices__note">Вартість консультацій і точну ціну вашої програми уточнюйте за телефоном.</p>
        <div class="prices__actions">
          <CallButton />
          <FutureLink>Повний прайс</FutureLink>
        </div>
      </div>
      <div class="price-list">
        {priceGroups.map((g, i) => (
          <div class="price-group" style={`--i:${i}`}>
            <h3 class="price-group__title"><a href={`#${g.id}`} data-open={g.id}>{g.situation}</a></h3>
            <dl>
              {g.items.map((p) => (
                <div class="price">
                  <dt class="price__name">{p.name}{p.note && <span class="price__note">{p.note}</span>}</dt>
                  <dd class="price__value">{p.price}</dd>
                </div>
              ))}
            </dl>
          </div>
        ))}
      </div>
    </div>
  </Section>

  <!-- 7. Contacts: one schedule, address with floor and metro, phone, e-mail (R-106) -->
  <Section id="contacts" rec="R-106" class="contacts">
    <div class="container contacts__grid">
      <div class="contacts__main">
        <h2 class="h2">Як дістатися і записатися</h2>
        <a class="contacts__phone" href={site.phone.href}>{site.phone.text}</a>
        <CallButton size="lg" />
        <p class="contacts__more">
          <FutureLink>Правила для пацієнтів</FutureLink>
          <FutureLink>Протипоказання</FutureLink>
        </p>
      </div>
      <div class="contacts__side">
        <dl class="contacts__list">
          <div>
            <dt><Icon name="pin" size={20} /><span>Адреса</span></dt>
            <dd>Київ, {site.address.street}, {site.address.floor}<br />{site.address.metro}</dd>
          </div>
          <div>
            <dt><Icon name="clock" size={20} /><span>Графік</span></dt>
            <dd>Пн–Сб {site.hours.time}, Нд вихідний<span class="contacts__hint">графік уточнюйте за телефоном</span></dd>
          </div>
          <div>
            <dt><Icon name="mail" size={20} /><span>E-mail</span></dt>
            <dd><a class="text-link" href={site.email.href}>{site.email.text}</a></dd>
          </div>
          <div>
            <dt><Icon name="instagram" size={20} /><span>Instagram</span></dt>
            <dd><a class="text-link" href={site.instagram.href} rel="noopener" target="_blank">{site.instagram.handle}<span class="visually-hidden"> (відкриється в новій вкладці)</span></a></dd>
          </div>
        </dl>
        <figure class="placeholder placeholder--thumb" data-rec="R-305">
          <div class="placeholder__frame" role="img" aria-label="Місце для фото входу до центру на Лобановського, 17"></div>
          <figcaption class="placeholder__caption">фото входу — зображення клієнта</figcaption>
        </figure>
      </div>
    </div>
  </Section>

  <Footer slot="footer" />
  <CallBar slot="footer" />
</Base>
